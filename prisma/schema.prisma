generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum DeviceType {
  mobile
  tablet
  desktop
  bot
}

enum TrafficType {
  human
  ai_agent
  bot
}

enum HealthStatus {
  unknown
  healthy
  degraded
  down
}

enum DomainStatus {
  pending
  verified
  disabled
}

enum LinkRiskStatus {
  cleared
  review
  blocked
}

enum AbuseReportStatus {
  open
  investigating
  resolved
  rejected
}

model Url {
  id                         String         @id @default(cuid())
  originalUrl                String
  shortCode                  String         @unique
  title                      String?
  description                String?
  ogImage                    String?
  clicks                     Int            @default(0)
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  expiresAt                  DateTime?
  expiredUrl                 String?
  passwordHash               String?
  metaPixelId                String?
  googleTagId                String?
  xPixelId                   String?
  cloaked                    Boolean        @default(false)
  webhookUrl                 String?
  maxClicks                  Int?
  clicksReserved             Int            @default(0)
  userId                     String?
  user                       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  isActive                   Boolean        @default(true)
  managementTokenHash        String?
  workspaceId                String?
  workspace                  Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  deepLinkAppId              String?
  deepLinkApp                DeepLinkApp?   @relation(fields: [deepLinkAppId], references: [id], onDelete: SetNull)
  healthStatus               HealthStatus   @default(unknown)
  healthCheckedAt            DateTime?
  healthLatencyMs            Int?
  healthStatusCode           Int?
  healthLastError            String?
  healthConsecutiveFailures  Int            @default(0)
  healthConsecutiveSuccesses Int            @default(0)
  autoFailoverEnabled        Boolean        @default(true)
  lastHealthyRevisionId      String?
  riskStatus                 LinkRiskStatus @default(cleared)
  riskReason                 String?
  riskCheckedAt              DateTime?
  deletedAt                  DateTime?
  tags                       String[]

  clickEvents      ClickEvent[]
  clickDaily       ClickDaily[]
  rules            LinkRule[]
  goals            Goal[]
  conversions      ConversionEvent[]
  revisions        DestinationRevision[]
  healthChecks     DestinationHealthCheck[]
  domainLinks      DomainLink[]
  ownedDomains     BrandedDomain[]          @relation("DomainOwner")
  abuseReports     AbuseReport[]
  campaignLinks    CampaignLink[]
  primaryCampaigns Campaign[]               @relation("CampaignPrimaryUrl")

  @@index([healthStatus, healthCheckedAt])
  @@index([tags])
  @@map("urls")
}

model LinkRule {
  id                   String         @id @default(cuid())
  urlId                String
  name                 String
  destinationUrl       String
  priority             Int            @default(100)
  weight               Int            @default(100)
  enabled              Boolean        @default(true)
  countryCodes         String?
  deviceType           DeviceType?
  trafficType          TrafficType?
  aiAgent              String?
  os                   String?
  languageCodes        String?
  referrerDomain       String?
  startAt              DateTime?
  endAt                DateTime?
  riskStatus           LinkRiskStatus @default(cleared)
  riskReason           String?
  riskCheckedAt        DateTime?
  healthStatus         HealthStatus   @default(unknown)
  healthCheckedAt      DateTime?
  healthLatencyMs      Int?
  healthStatusCode     Int?
  healthLastError      String?
  consecutiveFailures  Int            @default(0)
  consecutiveSuccesses Int            @default(0)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  url          Url                      @relation(fields: [urlId], references: [id], onDelete: Cascade)
  clickEvents  ClickEvent[]
  conversions  ConversionEvent[]
  healthChecks DestinationHealthCheck[]

  @@index([urlId, enabled, priority])
  @@index([healthStatus, healthCheckedAt])
  @@map("link_rules")
}

model ClickEvent {
  id                String      @id @default(cuid())
  urlId             String
  ruleId            String?
  campaignVariantId String?
  ip                String?
  userAgent         String?
  referer           String?
  referrerHost      String?
  country           String?
  city              String?
  deviceType        DeviceType?
  trafficType       TrafficType @default(human)
  aiAgent           String?
  os                String?
  browser           String?
  language          String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  utmTerm           String?
  utmContent        String?
  visitorIdHash     String?
  createdAt         DateTime    @default(now())

  url         Url               @relation(fields: [urlId], references: [id], onDelete: Cascade)
  rule        LinkRule?         @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  conversions ConversionEvent[]

  @@index([urlId, createdAt])
  @@index([urlId, country])
  @@index([urlId, deviceType])
  @@index([ruleId, createdAt])
  @@index([visitorIdHash, createdAt])
  @@map("click_events")
}

model ClickDaily {
  id        String   @id @default(cuid())
  urlId     String
  dateKey   String
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  url Url @relation(fields: [urlId], references: [id], onDelete: Cascade)

  @@unique([urlId, dateKey])
  @@index([urlId, dateKey])
  @@map("click_daily")
}

model Goal {
  id        String   @id @default(cuid())
  urlId     String
  name      String
  eventKey  String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  url         Url               @relation(fields: [urlId], references: [id], onDelete: Cascade)
  conversions ConversionEvent[]
  daily       ConversionDaily[]

  @@unique([urlId, eventKey])
  @@index([urlId, enabled])
  @@map("goals")
}

model ConversionEvent {
  id            String   @id @default(cuid())
  urlId         String
  goalId        String
  clickEventId  String?
  ruleId        String?
  visitorIdHash String?
  valueCents    Int?
  currency      String?
  metadata      String?
  createdAt     DateTime @default(now())

  url        Url         @relation(fields: [urlId], references: [id], onDelete: Cascade)
  goal       Goal        @relation(fields: [goalId], references: [id], onDelete: Cascade)
  clickEvent ClickEvent? @relation(fields: [clickEventId], references: [id], onDelete: SetNull)
  rule       LinkRule?   @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([urlId, createdAt])
  @@index([goalId, createdAt])
  @@index([ruleId, createdAt])
  @@index([visitorIdHash, createdAt])
  @@map("conversion_events")
}

model ConversionDaily {
  id          String   @id @default(cuid())
  goalId      String
  dateKey     String
  conversions Int      @default(0)
  valueCents  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, dateKey])
  @@index([goalId, dateKey])
  @@map("conversion_daily")
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  name                    String?
  password                String
  emailVerifiedAt         DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  urls                    Url[]
  sessions                Session[]
  memberships             Membership[]
  apiKeys                 ApiKey[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  bioProfiles             BioProfile[]
  webhookEndpoints        WebhookEndpoint[]
  scimIdentities          ScimIdentity[]

  @@map("users")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  prefix     String
  scopes     String    @default("*")
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("api_keys")
}

model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

enum WorkspaceRole {
  owner
  admin
  editor
  analyst
  viewer
}

model Workspace {
  id                     String                  @id @default(cuid())
  name                   String
  slug                   String                  @unique
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  urls                   Url[]
  members                Membership[]
  invites                WorkspaceInvite[]
  bioProfiles            BioProfile[]
  webhookEndpoints       WebhookEndpoint[]
  campaigns              Campaign[]
  routingConfigSnapshots RoutingConfigSnapshot[]
  privacyPolicy          PrivacyPolicy?
  tenantQuota            TenantQuota?
  usageBuckets           UsageBucket[]
  ssoConnections         SsoConnection[]
  scimTokens             ScimToken[]
  scimIdentities         ScimIdentity[]
  deepLinkApps           DeepLinkApp[]
  idempotencyKeys        IdempotencyKey[]

  @@map("workspaces")
}

model Membership {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, role])
  @@map("workspace_memberships")
}

model WorkspaceInvite {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(viewer)
  tokenHash   String        @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdById String
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([workspaceId, expiresAt])
  @@map("workspace_invites")
}

model DestinationRevision {
  id             String   @id @default(cuid())
  urlId          String
  destinationUrl String
  reason         String?
  effectiveAt    DateTime
  createdAt      DateTime @default(now())

  url Url @relation(fields: [urlId], references: [id], onDelete: Cascade)

  @@index([urlId, effectiveAt])
  @@map("destination_revisions")
}

model DestinationHealthCheck {
  id         String       @id @default(cuid())
  urlId      String
  revisionId String?
  ruleId     String?
  targetUrl  String
  status     HealthStatus
  statusCode Int?
  latencyMs  Int?
  error      String?
  checkedAt  DateTime     @default(now())

  url  Url       @relation(fields: [urlId], references: [id], onDelete: Cascade)
  rule LinkRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([urlId, checkedAt])
  @@index([ruleId, checkedAt])
  @@index([revisionId, checkedAt])
  @@map("destination_health_checks")
}

model BrandedDomain {
  id                      String       @id @default(cuid())
  host                    String       @unique
  verificationToken       String       @unique
  ownerUrlId              String?
  status                  DomainStatus @default(pending)
  verifiedAt              DateTime?
  lastCheckedAt           DateTime?
  tlsReady                Boolean      @default(false)
  tlsProvider             String?
  tlsStatus               String?
  tlsCertificateExpiresAt DateTime?
  tlsLastCheckedAt        DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  owner     Url?             @relation("DomainOwner", fields: [ownerUrlId], references: [id], onDelete: SetNull)
  links     DomainLink[]
  provision DomainProvision?

  @@index([status, lastCheckedAt])
  @@map("branded_domains")
}

model DomainLink {
  id        String   @id @default(cuid())
  domainId  String
  urlId     String
  path      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domain BrandedDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  url    Url           @relation(fields: [urlId], references: [id], onDelete: Cascade)

  @@unique([domainId, path])
  @@index([urlId])
  @@map("domain_links")
}

model AbuseReport {
  id        String            @id @default(cuid())
  urlId     String
  reason    String
  details   String?
  reporter  String?
  status    AbuseReportStatus @default(open)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  url Url @relation(fields: [urlId], references: [id], onDelete: Cascade)

  @@index([urlId, status, createdAt])
  @@map("abuse_reports")
}

model AuditEvent {
  id           String   @id @default(cuid())
  action       String
  actorType    String
  actorUserId  String?
  sessionId    String?
  urlId        String?
  resourceType String?
  resourceId   String?
  ipHash       String?
  userAgent    String?
  beforeJson   String?
  afterJson    String?
  metadataJson String?
  createdAt    DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([urlId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([action, createdAt])
  @@map("audit_events")
}

enum BioBlockType {
  link
  socials
  text
  image
  youtube
  spotify
  divider
}

model BioProfile {
  id          String   @id @default(cuid())
  userId      String?
  workspaceId String?
  handle      String   @unique
  displayName String?
  bioText     String?
  avatarUrl   String?
  theme       String   @default("light")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  blocks    BioBlock[]

  @@index([userId])
  @@index([workspaceId])
  @@map("bio_profiles")
}

model BioBlock {
  id           String       @id @default(cuid())
  profileId    String
  type         BioBlockType
  position     Int          @default(0)
  title        String?
  url          String?
  content      String?
  metadataJson String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  profile BioProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, position])
  @@map("bio_blocks")
}

enum WebhookStatus {
  pending
  success
  failed
}

model WebhookEndpoint {
  id          String   @id @default(cuid())
  workspaceId String?
  userId      String?
  url         String
  secret      String
  isActive    Boolean  @default(true)
  events      String[] // Array of event names like "click", "conversion"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user       User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([workspaceId])
  @@index([userId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id            String        @id @default(cuid())
  endpointId    String
  event         String
  payload       String // JSON string
  status        WebhookStatus @default(pending)
  responseCode  Int?
  responseBody  String?
  attempts      Int           @default(0)
  nextAttemptAt DateTime?
  lastAttemptAt DateTime?
  leaseToken    String?
  leaseUntil    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@map("webhook_deliveries")
}

enum CampaignStatus {
  draft
  scheduled
  running
  paused
  completed
  archived
}

enum OptimizationObjective {
  conversion_rate
  revenue_per_click
  revenue
  conversion_value
}

enum ExperimentStatus {
  draft
  running
  paused
  completed
  promoted
}

enum ReleaseStatus {
  draft
  pending_approval
  approved
  rejected
  published
  rolled_back
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum SsoProviderType {
  saml
}

enum DomainProvisionStatus {
  requested
  verifying
  provisioning
  active
  failed
  renewal_due
  renewal_in_progress
  disabled
}

enum UsageMetric {
  clicks
  conversions
  api_requests
  webhook_deliveries
  active_links
  storage_bytes
}

enum AnomalyType {
  traffic_spike
  traffic_drop
  destination_latency
  destination_error_rate
  conversion_drop
  conversion_spike
}

enum AnomalySeverity {
  info
  warning
  critical
}

model Campaign {
  id                     String                @id @default(cuid())
  workspaceId            String
  name                   String
  slug                   String
  status                 CampaignStatus        @default(draft)
  objective              OptimizationObjective @default(conversion_rate)
  currency               String                @default("USD")
  autoOptimize           Boolean               @default(false)
  confidenceThreshold    Int                   @default(95)
  minSampleSize          Int                   @default(100)
  minConversions         Int                   @default(10)
  maxTrafficShiftPercent Int                   @default(20)
  startAt                DateTime?
  endAt                  DateTime?
  timezone               String                @default("UTC")
  primaryUrlId           String?
  currentExperimentId    String?
  version                Int                   @default(1)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  primaryUrl  Url?                 @relation("CampaignPrimaryUrl", fields: [primaryUrlId], references: [id], onDelete: SetNull)
  variants    CampaignVariant[]
  links       CampaignLink[]
  experiments CampaignExperiment[]
  releases    CampaignRelease[]
  decisions   CampaignDecision[]
  anomalies   CampaignAnomaly[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
  @@index([status, startAt])
  @@map("campaigns")
}

model CampaignVariant {
  id                String   @id @default(cuid())
  campaignId        String
  name              String
  destinationUrl    String
  isControl         Boolean  @default(false)
  enabled           Boolean  @default(true)
  weight            Int      @default(50)
  clicks            Int      @default(0)
  conversions       Int      @default(0)
  valueCents        BigInt   @default(0)
  valueSquaredCents Decimal  @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, enabled])
  @@map("campaign_variants")
}

model CampaignLink {
  id         String   @id @default(cuid())
  campaignId String
  urlId      String
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  url        Url      @relation(fields: [urlId], references: [id], onDelete: Cascade)

  @@unique([campaignId, urlId])
  @@index([urlId])
  @@map("campaign_links")
}

model CampaignExperiment {
  id                String                @id @default(cuid())
  campaignId        String
  status            ExperimentStatus      @default(draft)
  objective         OptimizationObjective
  controlVariantId  String?
  startedAt         DateTime?
  endedAt           DateTime?
  promotedVariantId String?
  lookCount         Int                   @default(0)
  alphaSpent        Float                 @default(0)
  lastLookAt        DateTime?
  cooldownUntil     DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  campaign          Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  snapshots         ExperimentSnapshot[]

  @@index([campaignId, status])
  @@map("campaign_experiments")
}

model ExperimentSnapshot {
  id           String             @id @default(cuid())
  experimentId String
  sequence     Int
  configJson   String
  statsJson    String
  decisionJson String?
  contentHash  String
  previousHash String?
  createdAt    DateTime           @default(now())
  experiment   CampaignExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@unique([experimentId, sequence])
  @@unique([experimentId, contentHash])
  @@index([experimentId, createdAt])
  @@map("experiment_snapshots")
}

model CampaignDecision {
  id             String   @id @default(cuid())
  campaignId     String
  experimentId   String?
  action         String
  reason         String
  confidenceBps  Int?
  oldWeightsJson String?
  newWeightsJson String?
  actorType      String
  actorUserId    String?
  createdAt      DateTime @default(now())
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@map("campaign_decisions")
}

model CampaignRelease {
  id                    String                    @id @default(cuid())
  campaignId            String
  version               Int
  status                ReleaseStatus             @default(draft)
  configJson            String
  configHash            String
  scheduledAt           DateTime?
  publishedAt           DateTime?
  approvalQuorum        Int                       @default(1)
  requiredApprovalRoles String                    @default("owner")
  createdById           String?
  createdAt             DateTime                  @default(now())
  campaign              Campaign                  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  approvals             CampaignReleaseApproval[]

  @@unique([campaignId, version])
  @@index([status, scheduledAt])
  @@map("campaign_releases")
}

model CampaignReleaseApproval {
  id             String          @id @default(cuid())
  releaseId      String
  reviewerUserId String
  status         ApprovalStatus  @default(pending)
  roleSnapshot   WorkspaceRole?
  comment        String?
  createdAt      DateTime        @default(now())
  decidedAt      DateTime?
  release        CampaignRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([releaseId, reviewerUserId])
  @@map("campaign_release_approvals")
}

model RoutingConfigSnapshot {
  id                  String    @id @default(cuid())
  workspaceId         String
  version             Int
  payloadJson         String
  contentHash         String
  previousHash        String?
  signature           String
  publishedAt         DateTime  @default(now())
  replicatedAt        DateTime?
  replicationAttempts Int       @default(0)
  createdAt           DateTime  @default(now())
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, version])
  @@unique([workspaceId, contentHash])
  @@index([workspaceId, publishedAt])
  @@map("routing_config_snapshots")
}

model CampaignAnomaly {
  id          String          @id @default(cuid())
  campaignId  String
  fingerprint String
  type        AnomalyType
  severity    AnomalySeverity
  metric      String
  baseline    Float
  observed    Float
  deviation   Float
  detailsJson String?
  startedAt   DateTime
  resolvedAt  DateTime?
  createdAt   DateTime        @default(now())
  campaign    Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, fingerprint, startedAt])
  @@index([campaignId, resolvedAt, createdAt])
  @@map("campaign_anomalies")
}

model PrivacyPolicy {
  id             String    @id @default(cuid())
  workspaceId    String    @unique
  region         String    @default("global")
  retentionDays  Int       @default(90)
  hashIp         Boolean   @default(true)
  hashVisitor    Boolean   @default(true)
  storeUserAgent Boolean   @default(false)
  storeReferrer  Boolean   @default(true)
  aggregateOnly  Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("privacy_policies")
}

model TenantQuota {
  id                        String    @id @default(cuid())
  workspaceId               String    @unique
  clicksPerMonth            BigInt    @default(100000)
  apiRequestsPerMonth       BigInt    @default(10000)
  conversionsPerMonth       BigInt    @default(10000)
  webhookDeliveriesPerMonth BigInt    @default(10000)
  activeLinks               Int       @default(1000)
  storageBytes              BigInt    @default(1073741824)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  workspace                 Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("tenant_quotas")
}

model UsageBucket {
  id          String      @id @default(cuid())
  workspaceId String
  metric      UsageMetric
  periodKey   String
  quantity    BigInt      @default(0)
  updatedAt   DateTime    @updatedAt
  createdAt   DateTime    @default(now())
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, metric, periodKey])
  @@index([workspaceId, periodKey])
  @@map("usage_buckets")
}

model SamlRelayNonce {
  id           String   @id @default(cuid())
  nonce        String   @unique
  connectionId String
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([connectionId, expiresAt])
  @@index([consumedAt, expiresAt])
  @@map("saml_relay_nonces")
}

model SsoConnection {
  id              String          @id @default(cuid())
  workspaceId     String
  type            SsoProviderType @default(saml)
  name            String
  entityId        String
  idpEntityId     String
  ssoUrl          String
  x509Certificate String
  emailAttribute  String          @default("email")
  nameAttribute   String?
  allowedDomains  String?
  enabled         Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([workspaceId, enabled])
  @@map("sso_connections")
}

model ScimToken {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  tokenHash   String    @unique
  prefix      String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, revokedAt])
  @@map("scim_tokens")
}

model ScimIdentity {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  externalId  String
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, externalId])
  @@unique([workspaceId, userId])
  @@map("scim_identities")
}

model DomainProvision {
  id                  String                @id @default(cuid())
  domainId            String                @unique
  status              DomainProvisionStatus @default(requested)
  verificationMethod  String                @default("dns_txt")
  verificationValue   String
  dnsTarget           String?
  certificateProvider String?
  certificateId       String?
  renewalAttempts     Int                   @default(0)
  nextRenewalAt       DateTime?
  lastError           String?
  checkedAt           DateTime?
  activatedAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  domain              BrandedDomain         @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@map("domain_provisions")
}

model DeepLinkApp {
  id                       String    @id @default(cuid())
  workspaceId              String
  name                     String
  environment              String    @default("production")
  appVersion               String?
  minimumAppVersion        String?
  resolverEnabled          Boolean   @default(true)
  iosResolverScheme        String?
  androidResolverScheme    String?
  packageName              String?
  bundleId                 String?
  appleTeamId              String?
  androidSha256            String?
  iosStoreUrl              String?
  androidStoreUrl          String?
  iosAssociatedDomainsJson String?
  androidAssetLinksJson    String?
  enabled                  Boolean   @default(true)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  workspace                Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  urls                     Url[]

  @@index([workspaceId, enabled])
  @@map("deep_link_apps")
}

model IdempotencyKey {
  id             String    @id @default(cuid())
  workspaceId    String
  keyHash        String
  method         String
  path           String
  requestHash    String
  responseStatus Int
  responseJson   String
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, keyHash])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
