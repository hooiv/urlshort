{
  "name": "urlshort",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:soak": "vitest run --no-file-parallelism src/lib/production-soak.test.ts src/lib/production-soak.integration.test.ts src/lib/production-soak.redis.integration.test.ts src/lib/production-soak.replica.integration.test.ts",
    "sdk:build": "npm --prefix sdk run build",
    "sdk:verify": "npm --prefix sdk run verify",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "test:soak:db": "vitest run src/lib/production-soak.integration.test.ts"
  },
  "dependencies": {
    "@node-saml/node-saml": "^5.1.0",
    "@prisma/client": "^6.8.2",
    "bcryptjs": "^3.0.2",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.511.0",
    "nanoid": "^5.1.16",
    "next": "16.3.3",
    "prisma": "^6.8.2",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.5.2",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "postcss": "8.5.26",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
